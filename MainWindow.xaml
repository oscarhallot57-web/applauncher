<Window x:Class="AppLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AppLauncher.Converters"
        Title="App Launcher"
        Width="700" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Visibility="Hidden">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:StringEmptyToVisibilityConverter x:Key="StringEmptyToVis"/>
        <conv:CountToVisibilityConverter x:Key="CountToVis"/>

        <SolidColorBrush x:Key="PanelBrush" Color="#EC1E1E24"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFF2F2F2"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#99FFFFFF"/>
        <SolidColorBrush x:Key="SelectionBrush" Color="#332979FF"/>

        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Margin="8,3" Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="18" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
            VerticalAlignment="Top">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.45"/>
        </Border.Effect>
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" CenterX="350" CenterY="0"/>
        </Border.RenderTransform>

        <StackPanel>

            <!-- Search bar -->
            <Grid Height="64" Margin="10,10,10,4">
                <Border CornerRadius="14" Background="#14FFFFFF"/>
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                               FontSize="20" Foreground="{StaticResource SubTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Rechercher une application..." Foreground="{StaticResource SubTextBrush}"
                                   FontSize="20" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVis}}"/>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                                 FontSize="20" VerticalContentAlignment="Center"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                    </Grid>

                    <TextBlock Grid.Column="2" Text="Ctrl Espace" Foreground="{StaticResource SubTextBrush}"
                               FontSize="12" VerticalAlignment="Center" Opacity="0.6"/>
                </Grid>
            </Grid>

            <!-- Results -->
            <ListBox x:Name="ResultsList" Margin="0,0,0,8" MaxHeight="380"
                     Background="Transparent" BorderThickness="0"
                     ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource ResultItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="ResultsList_MouseDoubleClick"
                     Visibility="{Binding Results.Count, Converter={StaticResource CountToVis}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="30" Height="30" CornerRadius="6" Background="#22FFFFFF">
                                <Image Source="{Binding Icon}" Width="22" Height="22"/>
                            </Border>

                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource TextBrush}"
                                       FontSize="15" VerticalAlignment="Center" Margin="14,0,10,0"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock Grid.Column="2" Text="{Binding Category}" Foreground="{StaticResource SubTextBrush}"
                                       FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Aucune application trouvée" Foreground="{StaticResource SubTextBrush}"
                       FontSize="14" HorizontalAlignment="Center" Margin="0,10,0,20"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

        </StackPanel>
    </Border>
</Window>
